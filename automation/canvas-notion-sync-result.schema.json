{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "changes_seen", "notion_mutations", "changelog_updated", "pending_approvals", "warnings"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["applied", "noop", "error"]
    },
    "summary": {
      "type": "string"
    },
    "changes_seen": {
      "type": "integer",
      "minimum": 0
    },
    "notion_mutations": {
      "type": "integer",
      "minimum": 0
    },
    "changelog_updated": {
      "type": "boolean"
    },
    "pending_approvals": {
      "type": "array",
      "items": {"type": "string"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
