#!/usr/bin/env bash
set -Eeuo pipefail

# Bash 5.2 enables patsub_replacement, which expands an unquoted `&` in a
# substitution replacement to the matched text. Rendering a repository path
# containing `&` would otherwise reinsert the `@REPO_DIR@` placeholder.
shopt -u patsub_replacement 2>/dev/null || true

REPO_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_DIR
# shellcheck source=lib/config.sh
source "$REPO_DIR/scripts/lib/config.sh"
# shellcheck source=lib/schedule.sh
source "$REPO_DIR/scripts/lib/schedule.sh"

readonly SCHEDULERS=(systemd cron launchd agent)

usage() {
  cat <<'USAGE'
Usage: install-canvas-notion-automation [--scheduler NAME]

Installs the recurring Canvas-to-Notion sync using the scheduler named by
AUTOMATION_SCHEDULER in config.local.sh, or by --scheduler.

  systemd   systemd user timer (Linux). Persistent across downtime.
  cron      an entry in your user crontab. Portable; no catch-up after downtime.
  launchd   a user LaunchAgent (macOS). Runs missed jobs after wake.
  agent     install nothing; print the job definition for an external
            scheduler — an agent's own scheduled task, CI, or a human.

systemd reads SYSTEMD_ON_CALENDAR; cron and launchd read CRON_SCHEDULE.
Whatever the scheduler, the unit of work is scripts/run-canvas-notion-sync.
USAGE
}

scheduler=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --scheduler)
      [[ $# -ge 2 ]] || {
        printf '%s: --scheduler needs a name\n' "${0##*/}" >&2
        exit 64
      }
      scheduler=$2
      shift 2
      ;;
    --scheduler=*)
      scheduler=${1#--scheduler=}
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 64
      ;;
  esac
done

config::load

[[ -n "$scheduler" ]] || scheduler="$AUTOMATION_SCHEDULER"

known=false
for candidate in "${SCHEDULERS[@]}"; do
  [[ "$scheduler" == "$candidate" ]] && known=true && break
done
"$known" || config::die \
  "Unknown scheduler: '$scheduler'" \
  "Set AUTOMATION_SCHEDULER in config.local.sh, or pass --scheduler, to one of:" \
  "  ${SCHEDULERS[*]}"

# Note which binaries will be resolved from PATH rather than from an explicit
# override, before config::need_bins fills them in. A scheduler runs the job
# with a PATH of its own, and the backends check these against it.
PATH_RESOLVED_BINS=()
[[ -n "$CANVAS_BIN" ]] || PATH_RESOLVED_BINS+=(canvas)
[[ -n "$JQ_BIN" ]] || PATH_RESOLVED_BINS+=(jq)
[[ -n "$CODEX_BIN" ]] || PATH_RESOLVED_BINS+=(codex)

config::need_bins canvas jq codex flock unzip strings
config::need_canvas
config::need_notion

# shellcheck source=/dev/null
source "$REPO_DIR/scripts/schedulers/$scheduler.sh"
